datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// App user profile — `id` matches `auth.users.id` (Supabase Auth). Rows are created via SQL trigger (see `supabase/profile-trigger.sql`).
model Profile {
  id        String   @id @db.Uuid
  email     String?

  /// Required at signup from 2026-04-24 onward; nullable for 2 pre-existing users pending backfill (see design doc Open Question #11).
  firstName        String?
  lastName         String?
  /// "CFA" | "CFP_waitlist" | "other" — captured in onboarding.
  credentialType   String?
  /// Free-text/enum-ish: "cant_find_time" | "lose_focus" | "fall_behind" | "dont_know_pace" | "other".
  primaryChallenge String?
  /// "buy_side" | "sell_side" | "corporate_finance" | "student" | "other".
  employerType     String?
  /// How they heard about us: "linkedin" | "reddit" | "friend" | "search" | "other".
  attribution      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  exams      ExamInstance[]
  studyPlans StudyPlan[]
  studyLogs  StudyLog[]
  purchases  Purchase[]

  // Study plan persistence
  savedStudyPlan SavedStudyPlan?

  // Calendar Coach relations
  calendarConnections CalendarConnection[]
  studyWindows        StudyWindow[]
  studySessions       StudySession[]
  sessionPatterns     SessionPattern[]
  snoozedWindows      SnoozedWindow[]

  // Phase 1b — usage metering + survey responses
  usageEvents         UsageEvent[]
  surveyResponses    UserSurveyResponse[]

  // Web push subscriptions (one user can have multiple devices).
  pushSubscriptions   PushSubscription[]

  @@map("profiles")
}

/// Stripe Checkout / subscription purchase row. `stripeSessionId` is unique per Checkout Session (`cs_...`).
model Purchase {
  id              String @id @default(cuid())
  userId          String @db.Uuid
  stripeSessionId String @unique

  /// Set for All Access subscriptions — used for `invoice.paid` renewals.
  stripeSubscriptionId String? @unique

  /// Amount in smallest currency unit (e.g. cents), from session or invoice.
  amountTotal Int
  currency    String @default("usd")

  /// e.g. `paid`, `unpaid`, `past_due` — from Stripe.
  status String

  /// `free` is not stored as Purchase; values: `level_pass`, `all_access`.
  planKey String?

  examWindow      String?
  examYear        Int?
  accessExpiresAt DateTime?
  levelUnlocked   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@map("purchases")
}

model ExamDefinition {
  id     String                @id @default(cuid())
  slug   String                @unique
  name   String
  topics ExamTopicDefinition[]
  exams  ExamInstance[]
}

model ExamTopicDefinition {
  id               String @id @default(cuid())
  examDefinitionId String
  name             String
  recommendedHours Int

  examDefinition ExamDefinition @relation(fields: [examDefinitionId], references: [id])
  planItems      PlanItem[]
  studyLogs      StudyLog[]
  studySessions  StudySession[]
}

model ExamInstance {
  id               String   @id @default(cuid())
  userId           String   @db.Uuid
  examDefinitionId String
  examDate         DateTime
  weeklyHours      Int
  createdAt        DateTime @default(now())

  user           Profile        @relation(fields: [userId], references: [id])
  examDefinition ExamDefinition @relation(fields: [examDefinitionId], references: [id])
  studyPlans     StudyPlan[]
}

model StudyPlan {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  examInstanceId String
  generatedAt    DateTime @default(now())
  totalWeeks     Int
  totalHours     Int
  version        Int      @default(1)

  user         Profile      @relation(fields: [userId], references: [id])
  examInstance ExamInstance @relation(fields: [examInstanceId], references: [id])
  weeks        PlanWeek[]
  studyLogs    StudyLog[]
}

model PlanWeek {
  id           String   @id @default(cuid())
  studyPlanId  String
  weekIndex    Int
  startDate    DateTime
  endDate      DateTime
  plannedHours Int

  studyPlan StudyPlan  @relation(fields: [studyPlanId], references: [id])
  items     PlanItem[]
}

model PlanItem {
  id                    String @id @default(cuid())
  planWeekId            String
  examTopicDefinitionId String
  plannedHours          Int

  planWeek  PlanWeek            @relation(fields: [planWeekId], references: [id])
  topic     ExamTopicDefinition @relation(fields: [examTopicDefinitionId], references: [id])
  studyLogs StudyLog[]
}

model StudyLog {
  id                    String   @id @default(cuid())
  userId                String   @db.Uuid
  studyPlanId           String
  planItemId            String?
  examTopicDefinitionId String
  date                  DateTime
  actualHours           Float // Changed from Int — sub-hour sessions (7-25 min) round to 0 as Int

  user      Profile             @relation(fields: [userId], references: [id])
  studyPlan StudyPlan           @relation(fields: [studyPlanId], references: [id])
  planItem  PlanItem?           @relation(fields: [planItemId], references: [id])
  topic     ExamTopicDefinition @relation(fields: [examTopicDefinitionId], references: [id])
}

// ─── Saved Study Plan (JSON blob persistence) ───

/// Persists the user's active study plan settings, weekly schedule, and progress.
/// One active plan per user (`userId` is @unique). Plan arrays stored as JSON.
model SavedStudyPlan {
  id              String   @id @default(cuid())
  userId          String   @unique @db.Uuid
  examLevel       String   // "I" | "II" | "III"
  examDate        String   // ISO date "2026-11-15"
  weeklyHours     Int
  planStartDate   String   // ISO date
  weekStartDay    String   // "0"-"6" (0=Sunday)
  levelIIIPathway String?  // null for Level I/II
  forecastDays    Int      @default(1) // 1, 3, or 5
  /// Default target length (minutes) for Calendar Coach sessions; also caps how large each generated gap chunk is.
  calendarPreferredSessionMin Int @default(45)
  /// Earliest hour Calendar Coach will suggest a study window (0-23). Default 7 (7am).
  dayStartHour                Int @default(7)
  /// Latest hour Calendar Coach will suggest a study window (1-24). Default 22 (10pm).
  dayEndHour                  Int @default(22)
  weekPlan        Json     // WeekPlan[] with dates as ISO strings
  baseWeekPlan    Json     // original unmodified plan for undo
  actualHours     Json     // (number | null)[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_study_plans")
}

// ─── Calendar Coach Models ───

/// OAuth connection to a calendar provider (Google, Outlook). One user can have multiple.
model CalendarConnection {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  provider       String // "google" | "outlook"
  providerEmail  String // e.g. "david@work.com" — display only
  accessToken    String // encrypted at rest via lib/calendar/crypto
  refreshToken   String // encrypted at rest
  tokenExpiresAt DateTime
  scopes         String // space-separated OAuth scopes granted
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@unique([userId, provider, providerEmail])
  @@index([userId])
  @@map("calendar_connections")
}

/// Synced calendar event from a provider. Only stores busy/free + times, never titles or details.
model CalendarEvent {
  id              String   @id @default(cuid())
  connectionId    String
  providerEventId String // provider's unique ID for dedup on sync
  startTime       DateTime
  endTime         DateTime
  busyStatus      String   @default("busy") // "busy" | "free" | "tentative"
  lastSyncedAt    DateTime @default(now())

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerEventId])
  @@index([connectionId, startTime])
  @@map("calendar_events")
}

/// Detected study window (gap between calendar events). Re-generated on every sync.
model StudyWindow {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  startTime   DateTime
  endTime     DateTime
  durationMin Int
  /// Recommended topic + type, set by the topic recommender
  topicName   String?
  studyType   String? // "review" | "new" | "practice"
  /// Whether a notification was sent for this window
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]
  snoozes  SnoozedWindow[]

  @@index([userId, startTime])
  @@map("study_windows")
}

/// Actual study session started from a window. One window → at most one session.
model StudySession {
  id                    String    @id @default(cuid())
  userId                String    @db.Uuid
  windowId              String    @unique // one session per window (idempotent start)
  examTopicDefinitionId String?   // links session to study plan topic for progress tracking
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  interrupted           Boolean   @default(false)
  /// Target timer length chosen at start (minutes, <= window duration). Null = use full window.
  plannedDurationMin    Int?
  /// Wall-clock duration in minutes (server-derived: completedAt - startedAt)
  actualMin             Float?

  user   Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  window StudyWindow          @relation(fields: [windowId], references: [id], onDelete: Cascade)
  topic  ExamTopicDefinition? @relation(fields: [examTopicDefinitionId], references: [id])

  @@index([userId, startedAt])
  @@map("study_sessions")
}

/// Tracks study completion patterns by day-of-week and hour for optimization.
model SessionPattern {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  dayOfWeek      Int // 0-6 (Sunday-Saturday)
  hourSlot       Int // 0-23
  completionRate Float // 0.0-1.0
  avgDurationMin Float
  sessionCount   Int
  lastUpdated    DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek, hourSlot])
  @@index([userId])
  @@map("session_patterns")
}

// ─── Phase 1b: Usage Metering + Research ───

/// Records a capped action (rebalance, nudge_sent, etc.) for weekly usage counting.
/// Phase 1b freemium caps — count-in-rolling-window, not a per-week counter row.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  /// Enum-ish: "rebalance" | "nudge_sent" | other capped actions.
  action    String
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
  @@map("usage_events")
}

/// Web push subscription (PushManager.subscribe output). One row per device per user.
/// `endpoint` is unique per subscription; re-subscribes on the same device upsert by endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  /// Provider push URL (FCM / Apple / Mozilla). Used as the natural unique key.
  endpoint  String   @unique
  /// base64url ECDH p256 public key from the browser subscription.
  p256dh    String
  /// base64url auth secret from the browser subscription.
  auth      String
  /// Display-only: "chrome" | "firefox" | "safari" | "edge" | "other".
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// One row per survey answer. Questions are rotated in-digest / in-app; answers are analyzed monthly.
model UserSurveyResponse {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  /// Short identifier for the question (e.g. "week2_blocker", "nps_v1", "cap_hit_upgrade_reason").
  question   String
  /// The literal answer text (or chosen option key).
  answer     String
  answeredAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, question])
  @@map("user_survey_responses")
}

/// Tracks snoozed notification windows for re-notification.
model SnoozedWindow {
  id          String   @id @default(cuid())
  windowId    String
  userId      String   @db.Uuid
  snoozeUntil DateTime
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  window StudyWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  user   Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([snoozeUntil, notified])
  @@index([userId])
  @@map("snoozed_windows")
}
