# Database (SQLite for local dev; path is relative to prisma/schema.prisma → prisma/dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth — NEXTAUTH_URL must match the site origin (no trailing slash) or session fetch
# can return HTML and trigger CLIENT_FETCH_ERROR in the browser.
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: canonical site URL for Open Graph / metadata (no trailing slash). On Vercel, VERCEL_URL is used if unset.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
