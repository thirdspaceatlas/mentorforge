# Copy to `.env` and fill in values. Never commit `.env`.
# Syntax: KEY=value (no spaces around `=`). Use quotes if a value contains spaces.

# Supabase — Project Settings → API (URL + anon public key)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Prisma / Postgres — Supabase: Settings → Database
# Use the pooled connection string for DATABASE_URL (often port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) URL for migrations — port 5432
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Required in production for correct Open Graph / LinkedIn preview image URLs (absolute https). No trailing slash.
# On Vercel, VERCEL_URL is used if unset — set this to your public domain so og:image matches the site users share.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Stripe — Dashboard → Developers → API keys (test keys locally)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret: Dashboard webhook endpoint, or `stripe listen` output (`whsec_...`)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — Level Pass: one-time payment; All Access: recurring yearly (Dashboard → Products → Price)
NEXT_PUBLIC_STRIPE_PRICE_LEVEL_PASS="price_..."
NEXT_PUBLIC_STRIPE_PRICE_ALL_ACCESS="price_..."

# Optional: promotion code id for retakes (create 50% off coupon in Stripe → Promotion codes)
# STRIPE_RETAKE_PROMOTION_CODE_ID="promo_..."

# ─── Calendar Coach (OAuth + sync) ───

# Google Calendar — Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="https://your-domain.com/api/calendar/oauth/google/callback"

# Outlook Calendar — Azure AD: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
OUTLOOK_CLIENT_ID="your-azure-app-client-id"
OUTLOOK_CLIENT_SECRET="your-azure-client-secret"
OUTLOOK_REDIRECT_URI="https://your-domain.com/api/calendar/oauth/outlook/callback"
OUTLOOK_TENANT_ID="common"

# 32-byte hex key for encrypting OAuth tokens at rest (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_ENCRYPTION_KEY="your-64-char-hex-string"

# Shared secret for cron endpoint authentication
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="your-cron-secret"
