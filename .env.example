# Copy to `.env` and fill in values. Never commit `.env`.
# Syntax: KEY=value (no spaces around `=`). Use quotes if a value contains spaces.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Use either legacy anon (JWT) or new publishable key (`sb_publishable_...`) — not both required
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service role (server/scripts only — never in client bundles).
# Required for: `npm run guest:yc`, account deletion (`DELETE /api/account`), admin scripts.
# Supabase → Project Settings → API → service_role (never `NEXT_PUBLIC_*`).
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# HMAC secret for signed survey links in weekly digest + one-click unsubscribe.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional dedicated unsubscribe secret; otherwise SURVEY_LINK_SECRET is used.
SURVEY_LINK_SECRET="your-64-char-hex-or-long-random-string"
# EMAIL_UNSUBSCRIBE_SECRET="optional-separate-secret"

# Prisma / Postgres — Supabase: Settings → Database
# Use the pooled connection string for DATABASE_URL (often port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) URL for migrations — port 5432
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Required in production for correct Open Graph / LinkedIn preview image URLs (absolute https). No trailing slash.
# Use your real public origin (e.g. https://www.mentorforge.co). Must match Supabase Auth → URL Configuration → Site URL.
# After changing, redeploy on Vercel so Next.js embeds the new value in client bundles.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Plausible data-domain (defaults to hostname of NEXT_PUBLIC_SITE_URL, e.g. www.mentorforge.co)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="www.mentorforge.co"
#
# Local dev note:
# If you `vercel env pull` into `.env.local`, you may copy production NEXT_PUBLIC_SITE_URL.
# The app uses it for canonical redirects in `proxy.ts`, but localhost/LAN hosts are excluded
# so `npm run dev` still works. For `next start` previews, unset or override this for local.

# Stripe — Dashboard → Developers → API keys (test keys locally)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret: Dashboard webhook endpoint, or `stripe listen` output (`whsec_...`)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — Level Pass: one-time payment; All Access: recurring yearly (Dashboard → Products → Price)
NEXT_PUBLIC_STRIPE_PRICE_LEVEL_PASS="price_..."
NEXT_PUBLIC_STRIPE_PRICE_ALL_ACCESS="price_..."

# Optional: promotion code id for retakes (create 50% off coupon in Stripe → Promotion codes)
# STRIPE_RETAKE_PROMOTION_CODE_ID="promo_..."

# ─── Calendar Coach (OAuth + sync) ───

# Google Calendar — Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="https://your-domain.com/api/calendar/oauth/google/callback"

# Outlook Calendar — Azure AD: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
OUTLOOK_CLIENT_ID="your-azure-app-client-id"
OUTLOOK_CLIENT_SECRET="your-azure-client-secret"
OUTLOOK_REDIRECT_URI="https://your-domain.com/api/calendar/oauth/outlook/callback"
OUTLOOK_TENANT_ID="common"

# 32-byte hex key for encrypting OAuth tokens at rest (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_ENCRYPTION_KEY="your-64-char-hex-string"

# Shared secret for cron endpoint authentication
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="your-cron-secret"

# Resend — https://resend.com/api-keys (used by `/api/cron/outreach-email`)
RESEND_API_KEY="re_..."
# Verified sender domain in Resend, e.g. `MentorForge <hello@yourdomain.com>`
RESEND_FROM_EMAIL="MentorForge <hello@yourdomain.com>"

# Web push (VAPID) — Calendar Coach browser notifications
# Required on Vercel Production (and Preview if testing push there).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY.
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:hello@yourdomain.com"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
