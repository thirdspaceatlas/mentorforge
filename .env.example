# Supabase — Project Settings → API (URL + anon public key)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Prisma / Postgres — Supabase: Settings → Database
# Use the pooled connection string for DATABASE_URL (often port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) URL for migrations — port 5432
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Optional: canonical site URL for Open Graph / metadata (no trailing slash). On Vercel, VERCEL_URL is used if unset.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Stripe — Dashboard → Developers → API keys (test keys locally)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret: Dashboard webhook endpoint, or `stripe listen` output (`whsec_...`)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — Level Pass: one-time payment; All Access: recurring yearly (Dashboard → Products → Price)
NEXT_PUBLIC_STRIPE_PRICE_LEVEL_PASS="price_1TEdkaPH1hiuiHrN6fMZV3Tk"
NEXT_PUBLIC_STRIPE_PRICE_ALL_ACCESS="price_1TEdmGPH1hiuiHrN7K7f3tvb"

# Optional: promotion code id for retakes (create 50% off coupon in Stripe → Promotion codes)
# STRIPE_RETAKE_PROMOTION_CODE_ID="promo_..."
