{
  "name": "mentorforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "postinstall": "npm exec prisma generate && patch-package",
    "build": "npm exec prisma generate && npm exec prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "playwright:install": "playwright install chromium",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "guest:yc": "tsx scripts/create-yc-guest.ts",
    "user:test": "tsx scripts/create-test-user.ts",
    "guest:yc:grant": "tsx scripts/grant-all-access-by-email.ts",
    "revoke:yc": "tsx scripts/revoke-yc-reviewer.ts",
    "seed:demo": "tsx scripts/seed-demo-windows.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@prisma/client": "^6.12.0",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "latest",
    "clsx": "latest",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "postcss": "latest",
    "prisma": "^6.12.0",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.12.2",
    "stripe": "^20.4.1",
    "tailwindcss": "^3.4.17",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "25.5.0",
    "@types/react": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "patch-package": "^8.0.1",
    "tailwindcss-animate": "latest",
    "tsx": "^4.21.0",
    "typescript": "latest",
    "vitest": "^4.1.3"
  }
}
